<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="demo_asset_profile_property" model="account.asset.profile">
        <field name="name">Property Equipment</field>
        <field name="company_id" ref="base.main_company" />
        <field
            name="account_asset_id"
            search="[('account_type', '=', 'asset_fixed'), ('company_ids', 'in', ref('base.main_company'))]"
        />
        <field
            name="account_depreciation_id"
            search="[('account_type', '=', 'asset_fixed'), ('company_ids', 'in', ref('base.main_company'))]"
        />
        <field
            name="account_expense_depreciation_id"
            search="[('account_type', 'in', ('expense_depreciation', 'expense')), ('company_ids', 'in', ref('base.main_company'))]"
        />
        <field
            name="journal_id"
            search="[('type', '=', 'purchase'), ('company_id', '=', ref('base.main_company'))]"
        />
    </record>

    <record id="demo_asset_downtown_furniture" model="account.asset">
        <field name="name">Downtown Apartment – Furniture Set</field>
        <field name="property_id" ref="pms_base.demo_property_downtown" />
        <field name="profile_id" ref="demo_asset_profile_property" />
        <field name="purchase_value">8000.0</field>
        <field name="date_start" eval="time.strftime('%Y-01-01')" />
    </record>

    <record id="demo_asset_suburban_appliances" model="account.asset">
        <field name="name">Suburban House – Kitchen Appliances</field>
        <field name="property_id" ref="pms_base.demo_property_suburban" />
        <field name="profile_id" ref="demo_asset_profile_property" />
        <field name="purchase_value">5500.0</field>
        <field name="date_start" eval="time.strftime('%Y-01-01')" />
    </record>

    <record id="demo_asset_suburban_hvac" model="account.asset">
        <field name="name">Suburban House – HVAC System</field>
        <field name="property_id" ref="pms_base.demo_property_suburban" />
        <field name="profile_id" ref="demo_asset_profile_property" />
        <field name="purchase_value">12000.0</field>
        <field name="date_start" eval="time.strftime('%Y-01-01')" />
    </record>
</odoo>
