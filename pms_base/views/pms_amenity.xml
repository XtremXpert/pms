<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pms_amenity_form" model="ir.ui.view">
        <field name="name">pms.amenity.form</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <form string="Amenities">
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <h1>
                        <label for="name" string="Amenity" />
                        <field name="name" />
                    </h1>
                    <group id="main">
                        <group id="main-left">
                            <field name="type_id" string="Type" />
                        </group>
                        <group id="main-right">
                            <field name="default_code" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Properties">
                            <field
                                name="property_ids"
                                options="{'no_create': True,'no_open': True}"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pms_amenity_search" model="ir.ui.view">
        <field name="name">pms.amenity.search</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <search string="Amenities">
                <field name="name" />
                <field name="type_id" />
            </search>
        </field>
    </record>

    <record id="pms_amenity_view_tree" model="ir.ui.view">
        <field name="name">pms.amenity.tree</field>
        <field name="model">pms.amenity</field>
        <field name="arch" type="xml">
            <list string="Amenities">
                <field name="default_code" />
                <field name="name" />
                <field name="type_id" />
            </list>
        </field>
    </record>

    <record id="action_pms_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">pms.amenity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
